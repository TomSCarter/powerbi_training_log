	partition pre_clean_export = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "pre_clean_export.parquet"), [Compression=null, LegacyColumnNameEncoding=false, MaxDepth=null]),
				  #"Invalid values to null: placeholders in property_type and built_form" = Table.ReplaceValue(Source, "Not Recorded", null, Replacer.ReplaceValue, {"property_type", "built_form"}),
				  #"Invalid values to null: placeholder in tenure" = Table.ReplaceValue(#"Invalid values to null: placeholders in property_type and built_form", "unknown", null, Replacer.ReplaceValue, {"tenure"}),
				  #"Invalid values to null: heated rooms" = Table.ReplaceValue(#"Invalid values to null: placeholder in tenure", 0, null, Replacer.ReplaceValue, {"number_heated_rooms"}),
				  #"Invalid values to null: floor_height below 1.5 (new column)" = Table.AddColumn(#"Invalid values to null: heated rooms", "floor_height_nulled", each if ([floor_height] <> null and [floor_height] < 1.5) then null else [floor_height]),
				  #"Invalid values to null: remove original floor_height" = Table.RemoveColumns(#"Invalid values to null: floor_height below 1.5 (new column)", {"floor_height"}),
				  #"Invalid values to null: rename floor_height column" = Table.RenameColumns(#"Invalid values to null: remove original floor_height", {{"floor_height_nulled", "floor_height"}}),
				  #"Invalid values to null: set floor_height type" = Table.TransformColumnTypes(#"Invalid values to null: rename floor_height column", {{"floor_height", type number}}),
				  #"Apply exclusions: floor area 9 sqm or under" = Table.SelectRows(#"Invalid values to null: set floor_height type", each [total_floor_area] > 9),
				  #"Apply exclusions: huge properties with few or null rooms" = Table.SelectRows(#"Apply exclusions: floor area 9 sqm or under", each [total_floor_area] <= 2000 or ([number_habitable_rooms] > 7 and [number_habitable_rooms] <> null)),
				  #"Apply exclusions: flats/maisonettes with very high efficiency" = Table.SelectRows(#"Apply exclusions: huge properties with few or null rooms", each [current_energy_efficiency] <= 110 or [energy_consumption_current] <= 200 or not List.Contains(FlatTypes, [property_type])),
				  #"Apply exclusions: add construction_age_band length" = Table.AddColumn(#"Apply exclusions: flats/maisonettes with very high efficiency", "Length", each Text.Length([construction_age_band]), type nullable number),
				  #"Apply exclusions: construction_age_band under 4 characters" = Table.SelectRows(#"Apply exclusions: add construction_age_band length", each [Length] >= 4),
				  #"Apply exclusions: remove length helper column" = Table.RemoveColumns(#"Apply exclusions: construction_age_band under 4 characters", {"Length"}),
				  #"Impute floor height: Add floor_height imputed flag" = Table.AddColumn(#"Apply exclusions: remove length helper column", "floor_height_imputed", each [floor_height] = null),
				  #"Impute floor height: Change type on flag column" = Table.TransformColumnTypes(#"Impute floor height: Add floor_height imputed flag", {{"floor_height_imputed", type logical}}),
				  #"Impute floor height: Calculate median floor height" = List.Median(#"Impute floor height: Change type on flag column"[floor_height]),
				  #"Impute floor height: Return table after median" = #"Impute floor height: Change type on flag column",
				  #"Impute floor height: Impute" = Table.ReplaceValue(#"Impute floor height: Return table after median", null, #"Impute floor height: Calculate median floor height", Replacer.ReplaceValue, {"floor_height"})
				in
				    #"Impute floor height: Impute"

	annotation PBI_ResultType = Table

